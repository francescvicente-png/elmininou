---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import EditorialDivider from '../../components/EditorialDivider.astro';
import LocationBlock from '../../components/LocationBlock.astro';
import ContactChannelsSection from '../../components/sections/ContactChannelsSection.astro';
import FadeInOnScroll from '../../components/animations/FadeInOnScroll.astro';
import { business } from '../../data/business';

const lang = 'es' as const;
---

<BaseLayout
	title={`Contacto · ${business.name}`}
	description={`Dirección, teléfono, horario y cómo llegar a ${business.name}. ${business.address.street}, ${business.address.city}. Reserva por teléfono o WhatsApp.`}
	siblingPath="/ca/contacte/"
	keywords={[
		'contacto el mini nou',
		'restaurant la ametlla vallès teléfono',
		'jeroni de moragas restaurante',
		'reserva restaurant ametlla vallès',
	]}
	breadcrumbs={[
		{ name: 'Inicio', url: '/es/' },
		{ name: 'Contacto', url: '/es/contacto/' },
	]}
>
	<EditorialDivider
		number="—"
		eyebrow="Dónde encontrarnos"
		heading="Contacto"
		subheading="Todo lo que necesitas para encontrarnos: dirección, teléfono, horario y las otras maneras de contactar."
		as="h1"
		flushTop={false}
	/>

	<FadeInOnScroll delay={100}>
		<Container as="section" class="pb-16 md:pb-20">
			<LocationBlock lang={lang} headingLevel="h2" />
		</Container>
	</FadeInOnScroll>

	<FadeInOnScroll delay={150}>
		<ContactChannelsSection lang={lang} />
	</FadeInOnScroll>

</BaseLayout>
