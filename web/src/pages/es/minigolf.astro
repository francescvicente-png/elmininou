---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import FaqList from '../../components/FaqList.astro';
import { Icon } from 'astro-icon/components';
import { minigolfHighlights, minigolfPricing } from '../../data/minigolf';
import { minigolfFaqs } from '../../data/faq';
import { business } from '../../data/business';
import { getRoutePair } from '../../i18n/routes';
import { site } from '../../data/site';

const lang = 'es' as const;
const telHref = `tel:${business.phoneTel}`;
const cleanPhone = business.phoneTel.replace(/\D/g, '');
const waUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent('Hola, quería preguntar sobre el minigolf de El mini nou. Gracias.')}`;
const menuHref = getRoutePair('menu')[lang];

const schemaService = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Campo de minigolf de 18 hoyos',
	description:
		'Campo de minigolf de 18 hoyos integrado en el restaurante El mini nou. Acceso gratuito si comes en el restaurante; 5 € por persona si solo juegas.',
	provider: {
		'@type': 'Restaurant',
		'@id': `${site.canonicalUrl}/#localbusiness`,
	},
	offers: [
		{
			'@type': 'Offer',
			price: '0',
			priceCurrency: 'EUR',
			description: 'Gratuito para todo el grupo si comes en el restaurante',
		},
		{
			'@type': 'Offer',
			price: '5',
			priceCurrency: 'EUR',
			description: '5 € por persona si solo juegas. Palo y bola incluidos.',
		},
	],
	areaServed: { '@type': 'Place', name: 'La Ametlla del Vallès' },
});
---

<BaseLayout
	title={`Minigolf de 18 hoyos · ${business.name}`}
	description={`Campo de minigolf de 18 hoyos en ${business.address.city}. Gratis si comes en el restaurante. Familiar, para todos los niveles. Reserva mesa y juega.`}
	siblingPath="/ca/minigolf/"
	keywords={[
		'minigolf ametlla del vallès',
		'el mini nou minigolf',
		'minigolf restaurante vallès',
		'actividad familiar ametlla vallès',
		'minigolf gratis restaurante',
	]}
	breadcrumbs={[
		{ name: 'Inicio', url: '/es/' },
		{ name: 'Minigolf', url: '/es/minigolf/' },
	]}
>
	<script slot="head" type="application/ld+json" set:html={schemaService} />

	<!-- Hero -->
	<section class="border-b border-border bg-card px-4 pb-16 pt-12 sm:px-6 md:pb-20 md:pt-16">
		<div class="mx-auto max-w-3xl text-center">
			<p class="text-xs font-semibold uppercase tracking-[0.26em] text-primary">
				Minigolf · {business.address.city}
			</p>
			<h1
				class="font-display mt-4 text-4xl font-semibold leading-[1.06] tracking-tight text-foreground md:text-5xl"
			>
				Campo de minigolf de 18 hoyos
			</h1>
			<p class="mx-auto mt-5 max-w-xl text-xl leading-relaxed text-muted">
				Incluido si comes aquí. 5 € si solo juegas.
			</p>
			<div class="mt-8 flex flex-wrap justify-center gap-3">
				<Button as="a" href={telHref} variant="primary" size="lg">
					<Icon slot="icon-leading" name="tabler:phone" class="size-5" aria-hidden="true" />
					Reserva mesa y juega
				</Button>
				<Button as="a" href={menuHref} variant="secondary" size="lg">
					Ver la carta
				</Button>
			</div>
		</div>
	</section>

	<!-- Cómo funciona -->
	<section class="px-4 py-16 sm:px-6 md:py-24">
		<Container class="max-w-4xl">
			<div class="text-center">
				<p class="text-xs font-semibold uppercase tracking-[0.26em] text-primary">Cómo funciona</p>
				<h2 class="font-display mt-3 text-3xl font-semibold tracking-tight text-foreground md:text-4xl">
					3 pasos sencillos
				</h2>
			</div>
			<ol class="mt-12 grid gap-6 sm:grid-cols-3">
				{
					[
						{
							step: 1,
							icon: 'calendar',
							title: 'Reserva mesa',
							body: 'Llama o escribe por WhatsApp para confirmar mesa. Dinos cuántos sois.',
						},
						{
							step: 2,
							icon: 'tools-kitchen-2',
							title: 'Come o cena',
							body: 'Disfrutad de la carta: brasas, combinados, tapas y bocadillos.',
						},
						{
							step: 3,
							icon: 'flag',
							title: 'Juega gratis al minigolf',
							body: 'Pedid el material en sala y a jugar. El campo es vuestro sin coste adicional.',
						},
					].map((s) => (
						<li class="flex flex-col items-center rounded-2xl border border-border bg-card px-6 py-8 text-center shadow-sm">
							<span class="inline-flex size-12 items-center justify-center rounded-full bg-primary text-lg font-bold text-primary-foreground">
								{s.step}
							</span>
							<Icon
								name={`tabler:${s.icon}`}
								class="mt-5 size-8 text-primary"
								aria-hidden="true"
							/>
							<h3 class="font-display mt-4 text-xl font-semibold text-foreground">{s.title}</h3>
							<p class="mt-3 text-sm leading-relaxed text-muted">{s.body}</p>
						</li>
					))
				}
			</ol>
		</Container>
	</section>

	<!-- El campo -->
	<section class="border-y border-border bg-card px-4 py-16 sm:px-6 md:py-20">
		<Container class="max-w-4xl">
			<div class="grid gap-10 lg:grid-cols-2 lg:items-center">
				<div>
					<p class="text-xs font-semibold uppercase tracking-[0.26em] text-primary">El campo</p>
					<h2 class="font-display mt-3 text-3xl font-semibold tracking-tight text-foreground md:text-4xl">
						18 hoyos para todos
					</h2>
					<p class="mt-5 leading-relaxed text-muted">
						El campo de minigolf de El mini nou tiene 18 hoyos diseñados con un nivel de dificultad pensado para todos los públicos: desde niños pequeños hasta jugadores con experiencia. No hace falta saber jugar para disfrutarlo.
					</p>
					<p class="mt-4 leading-relaxed text-muted">
						El ambiente es familiar y relajado. Ideal para alargar la comida o la cena con una actividad al aire libre sin complicaciones.
					</p>
					<ul class="mt-6 space-y-3">
						{
							minigolfHighlights.map((h) => (
								<li class="flex items-start gap-3">
									<Icon
										name={`tabler:${h.icon}`}
										class="mt-0.5 size-5 shrink-0 text-primary"
										aria-hidden="true"
									/>
									<span class="text-sm leading-relaxed text-foreground">
										<strong>{h.title.es}</strong> — {h.description.es}
									</span>
								</li>
							))
						}
					</ul>
				</div>
				<div class="flex flex-col gap-4">
					<div class="rounded-2xl bg-[color-mix(in_oklch,var(--color-primary)_8%,var(--color-background))] px-8 py-10 text-center">
						<Icon name="tabler:flag" class="mx-auto size-12 text-primary" aria-hidden="true" />
						<p class="font-display mt-4 text-5xl font-bold text-foreground">18</p>
						<p class="mt-1 text-sm font-semibold uppercase tracking-wider text-muted">hoyos</p>
					</div>
					<div class="rounded-2xl border border-border bg-background px-6 py-6 text-center text-sm leading-relaxed text-muted">
						<Icon name="tabler:clock" class="mx-auto mb-3 size-6 text-muted" aria-hidden="true" />
						Duración aproximada de una partida: <strong class="text-foreground">45–60 min</strong>
					</div>
				</div>
			</div>
		</Container>
	</section>

	<!-- Precios -->
	<section class="px-4 py-16 sm:px-6 md:py-20">
		<Container class="max-w-3xl">
			<div class="text-center">
				<p class="text-xs font-semibold uppercase tracking-[0.26em] text-primary">Tarifas</p>
				<h2 class="font-display mt-3 text-3xl font-semibold tracking-tight text-foreground md:text-4xl">
					Acceso al campo
				</h2>
			</div>
			<div class="mt-10 grid gap-4 sm:grid-cols-2">
				{
					minigolfPricing.map((p) => (
						<div
							class:list={[
								'flex flex-col items-center rounded-2xl px-8 py-10 text-center shadow-sm',
								p.context === 'with-meal'
									? 'bg-primary text-primary-foreground shadow-md'
									: 'border border-border bg-card text-foreground',
							]}
						>
							<Icon
								name={p.context === 'with-meal' ? 'tabler:gift' : 'tabler:golf'}
								class:list={['size-10', p.context === 'with-meal' ? 'opacity-90' : 'text-muted']}
								aria-hidden="true"
							/>
							<p
								class:list={[
									'font-display mt-5 text-4xl font-bold',
									p.context === 'with-meal' ? '' : 'text-foreground',
								]}
							>
								{p.context === 'with-meal' ? 'GRATIS' : `${p.price} €`}
							</p>
							<p class:list={['mt-1 text-sm font-medium', p.context === 'with-meal' ? 'opacity-90' : 'text-muted']}>
								{p.unit.es}
							</p>
							<p
								class:list={[
									'mt-4 text-base font-semibold',
									p.context === 'with-meal' ? 'opacity-95' : 'text-foreground',
								]}
							>
								{p.label.es}
							</p>
							{p.note && (
								<p class:list={['mt-2 text-xs', p.context === 'with-meal' ? 'opacity-75' : 'text-muted']}>
									{p.note.es}
								</p>
							)}
						</div>
					))
				}
			</div>
		</Container>
	</section>

	<!-- FAQ minigolf -->
	<section class="border-t border-border bg-card px-4 py-16 sm:px-6 md:py-20">
		<Container class="max-w-3xl">
			<div class="mb-10 text-center">
				<p class="text-xs font-semibold uppercase tracking-[0.26em] text-primary">Preguntas</p>
				<h2 class="font-display mt-3 text-3xl font-semibold tracking-tight text-foreground md:text-4xl">
					Dudas frecuentes sobre el minigolf
				</h2>
			</div>
			<FaqList lang={lang} items={minigolfFaqs} headingLevel="h3" />
		</Container>
	</section>

	<!-- CTA final -->
	<section class="bg-primary px-4 py-16 text-primary-foreground sm:px-6 md:py-20">
		<div class="mx-auto max-w-3xl text-center">
			<h2 class="font-display text-3xl font-semibold tracking-tight md:text-4xl">
				Reservad mesa y venid a jugar
			</h2>
			<p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed opacity-90">
				Llamad o escribid por WhatsApp. Decidnos cuántos sois y a qué hora, y lo preparamos.
			</p>
			<div class="mt-8 flex flex-wrap justify-center gap-3">
				<a
					href={telHref}
					class="inline-flex items-center justify-center gap-2 rounded-full bg-primary-foreground px-8 py-3.5 font-body text-lg font-semibold text-primary shadow-sm transition-colors hover:bg-[color-mix(in_oklch,var(--color-primary-foreground)_92%,black)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-foreground focus-visible:ring-offset-2 focus-visible:ring-offset-primary"
				>
					<Icon name="tabler:phone" class="size-5 shrink-0" aria-hidden="true" />
					Llamadnos
				</a>
				<a
					href={waUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-primary-foreground px-8 py-3.5 font-body text-lg font-semibold text-primary-foreground transition-colors hover:bg-[color-mix(in_oklch,var(--color-primary-foreground)_14%,transparent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-foreground focus-visible:ring-offset-2 focus-visible:ring-offset-primary"
				>
					<Icon name="tabler:brand-whatsapp" class="size-5 shrink-0" aria-hidden="true" />
					WhatsApp
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
