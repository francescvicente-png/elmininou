---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Text from '../../components/Text.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import FadeInOnScroll from '../../components/animations/FadeInOnScroll.astro';
import MenuPageHero from '../../components/menu/MenuPageHero.astro';
import ServicesCategoryNav from '../../components/sections/ServicesCategoryNav.astro';
import ServicesGroupedCatalog from '../../components/sections/ServicesGroupedCatalog.astro';
import { Icon } from 'astro-icon/components';
import GalleryLightbox from '../../components/GalleryLightbox.astro';
import { getServicesGrouped, getServiceName } from '../../data/services';
import { MENU_PAGE_HERO_IMAGE } from '../../data/menu-illustrations';
import { business } from '../../data/business';
import { getBookingCta } from '../../data/site';
import { useTranslations } from '../../i18n/utils';

const lang = 'ca' as const;
const t = useTranslations(lang);
const booking = getBookingCta();
const grouped = getServicesGrouped();
const firstIllustratedServiceId = grouped
	.flatMap((g) => g.items)
	.find((s) => s.illustration)?.id;

const lightboxImages = grouped
	.flatMap((g) => g.items)
	.filter((s) => s.illustration != null)
	.map((s) => ({
		src: s.illustration!,
		alt: getServiceName(s, lang),
		photographer: '',
		photoLicense: 'ai-demo' as const,
	}));
---

<BaseLayout
	title={`Carta · ${business.name}`}
	description={`Menú amb preus orientatius · ${business.name} a ${business.address.city}: entrants, brases, combinats, entrepans i begudes. Al·lèrgenes en text; confirmar sempre al local.`}
	siblingPath="/es/menu/"
	keywords={[
		'restaurant ametlla vallès',
		'carta restaurant',
		'el mini nou',
		'tapes ametlla vallès',
	]}
	breadcrumbs={[
		{ name: 'Inici', url: '/ca/' },
		{ name: 'Carta', url: '/ca/menu/' },
	]}
	preloadImage={MENU_PAGE_HERO_IMAGE}
>
	<MenuPageHero lang={lang} />

	<FadeInOnScroll delay={80} instant>
		<section
			id="menu-dishes-start"
			class="sticky top-20 z-30 border-y border-[color-mix(in_oklch,var(--color-border)_88%,transparent)] bg-[color-mix(in_oklch,var(--color-card)_93%,transparent)] py-4 shadow-[0_10px_42px_-26px_oklch(26%_0.06_52/0.38)] backdrop-blur-xl supports-[backdrop-filter]:bg-[color-mix(in_oklch,var(--color-card)_80%,transparent)]"
		>
			<Container>
				<ServicesCategoryNav lang={lang} groups={grouped} />
			</Container>
		</section>
	</FadeInOnScroll>

	<FadeInOnScroll delay={100} instant>
		<Container as="section" class="pb-16 pt-8 md:pb-24 md:pt-10" aria-labelledby="menu-catalog-visual">
			<p id="menu-catalog-visual" class="sr-only">
				{t('services.dividerSub')}
			</p>
			<ServicesGroupedCatalog
				lang={lang}
				groups={grouped}
				firstIllustratedServiceId={firstIllustratedServiceId}
			/>
		</Container>
	</FadeInOnScroll>

	<FadeInOnScroll delay={100} instant>
		<section
			class="bg-card py-16 md:py-20"
			aria-labelledby="menu-allergens-policy"
		>
			<Container>
				<div
					class="mx-auto max-w-3xl rounded-xl border border-border bg-background/60 p-6 md:flex md:gap-8 md:p-10"
				>
					<Icon
						name="tabler:circle-check"
						class="h-10 w-10 shrink-0 text-primary hidden md:block"
						aria-hidden="true"
					/>
					<div class="min-w-0">
						<p class="font-body text-sm font-medium uppercase tracking-[0.16em] text-muted">
							{t('services.policyIntro')}
						</p>
						<h2
							id="menu-allergens-policy"
							class="mt-3 font-display text-2xl tracking-tight text-foreground md:text-3xl"
						>
							{t('services.policyHeading')}
						</h2>
						<Text variant="small" class="!mt-4 !text-base leading-relaxed text-muted max-w-[56ch]">
							{t('services.bookingPolicyNote')}
						</Text>
					</div>
				</div>
			</Container>
		</section>
	</FadeInOnScroll>

	<GalleryLightbox lang={lang} images={lightboxImages} />

	<FadeInOnScroll delay={100} instant>
		<CtaBanner
			title={t('cta.bannerTitle')}
			ctaLabel={t('cta.callToBook')}
			ctaHref={booking.href}
			ctaExternal={booking.external}
			variant="primary"
		/>
	</FadeInOnScroll>
</BaseLayout>
