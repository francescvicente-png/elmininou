---
// Root page: redirects to the visitor's preferred language.
// Static HTML + inline JS + meta-refresh fallback for no-JS clients.
// Does NOT use BaseLayout — this page never renders content; its only
// job is to bounce the visitor to /ca/ or /es/.
---

<!doctype html>
<html lang="ca">
	<head>
		<meta charset="UTF-8" />
		<title>El mini nou</title>
		<meta name="robots" content="noindex" />
		<meta http-equiv="refresh" content="0; url=/ca/" />
		<link rel="canonical" href="/ca/" />
		<script is:inline>
			(function () {
				var lang = (navigator.language || 'ca').toLowerCase();
				var target = lang.indexOf('es') === 0 ? '/es/' : '/ca/';
				window.location.replace(target);
			})();
		</script>
	</head>
	<body>
		<p>
			<a href="/ca/">Carregant... / Cargando...</a>
		</p>
	</body>
</html>
