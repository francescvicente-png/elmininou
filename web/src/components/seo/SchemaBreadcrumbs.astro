---
interface BreadcrumbItem {
	name: string;
	url: string;
}

interface Props {
	items: ReadonlyArray<BreadcrumbItem>;
}

const { items } = Astro.props;

const siteUrl = new URL('/', Astro.site).toString().replace(/\/$/, '');

// A breadcrumb of length 0 or 1 has no information value; skip rendering.
const shouldRender = items.length >= 2;

const schema = shouldRender
	? {
			'@context': 'https://schema.org',
			'@type': 'BreadcrumbList',
			itemListElement: items.map((item, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				name: item.name,
				item: item.url.startsWith('http')
					? item.url
					: `${siteUrl}${item.url}`,
			})),
		}
	: null;
---

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
