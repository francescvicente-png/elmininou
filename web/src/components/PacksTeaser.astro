---
/**
 * Cross-link teaser toward the bridal / novias landing page.
 * Rendered from services and products pages — replaces the old /packs/
 * teaser now that bridal packs live under /nuvies/ and /novias/.
 */
import { Icon } from 'astro-icon/components';
import Heading from './Heading.astro';
import Button from './Button.astro';
import { getRoutePair } from '../i18n/routes';
import type { Lang } from '../i18n/config';

interface Props {
	lang: Lang;
	class?: string;
}

const { lang, class: className } = Astro.props;
const bridalHref = getRoutePair('bridal')[lang];

const copy = {
	ca: {
		eyebrow: 'Gran dia',
		heading: 'Núvies i pentinats de casament',
		body: "Proves, dia B i packs pensats per al teu casament. El detall del servei el tancareu amb l'equip al saló.",
		cta: 'Veure núvies',
	},
	es: {
		eyebrow: 'Gran día',
		heading: 'Novias y peinados de boda',
		body: 'Pruebas, día B y packs pensados para tu boda. El detalle del servicio lo cerraréis con el equipo en el salón.',
		cta: 'Ver novias',
	},
}[lang];
---

<aside
	class:list={[
		'packs-teaser rounded-xl border border-border bg-card p-6 md:p-8 flex flex-col md:flex-row md:items-center gap-6',
		className,
	]}
>
	<div class="flex items-center gap-4 md:gap-5 flex-1">
		<Icon
			name="tabler:heart"
			class="h-10 w-10 text-primary shrink-0"
			aria-hidden="true"
		/>
		<div class="space-y-1">
			<p class="text-xs uppercase tracking-widest text-muted">
				{copy.eyebrow}
			</p>
			<Heading as="h2" size="h4">{copy.heading}</Heading>
			<p class="text-sm font-body text-muted leading-relaxed">
				{copy.body}
			</p>
		</div>
	</div>
	<Button as="a" href={bridalHref} variant="primary" size="md" class="shrink-0">
		{copy.cta}
		<Icon
			slot="icon-trailing"
			name="tabler:chevron-right"
			class="h-4 w-4"
			aria-hidden="true"
		/>
	</Button>
</aside>

<style>
	.packs-teaser {
		transition:
			transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 400ms cubic-bezier(0.22, 1, 0.36, 1),
			border-color 400ms cubic-bezier(0.22, 1, 0.36, 1);
		will-change: transform;
	}

	.packs-teaser:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 32px -8px oklch(30% 0.075 320 / 0.18);
		border-color: var(--color-primary);
	}

	@media (prefers-reduced-motion: reduce) {
		.packs-teaser,
		.packs-teaser:hover {
			transition: none;
			transform: none;
			box-shadow: none;
		}
	}
</style>
