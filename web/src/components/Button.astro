---
import type { HTMLAttributes } from 'astro/types';
import { Icon } from 'astro-icon/components';

interface Props extends HTMLAttributes<'button'> {
	/**
	 * Visual variants:
	 * - `primary` — aubergine fill, cream text. Default CTA. Uses the
	 *   primary token family directly: at L≈30% the aubergine carries
	 *   enough weight to act as the booking-button colour without
	 *   needing to borrow the accent.
	 * - `secondary` — outline + foreground text on cream. For
	 *   secondary actions on the cream background.
	 * - `inverse` — cream fill, primary text. Use on top of a
	 *   `bg-primary` surface (CtaBanner with `variant="primary"`).
	 * - `ghost` — text only, hover bg. Tertiary or icon-only buttons.
	 * - `onImage` — outline + on-image cream text. Use ONLY when the
	 *   button sits over a darkened photo (Hero secondary CTA, image-
	 *   backed sections). The on-image cream gives the contrast that
	 *   `secondary` (foreground = near-black) lacks on a dark surface.
	 */
	variant?: 'primary' | 'secondary' | 'inverse' | 'ghost' | 'onImage';
	size?: 'sm' | 'md' | 'lg';
	as?: 'button' | 'a';
	href?: string;
	external?: boolean;
	/**
	 * Suppresses the auto-appended "external-link" glyph even when
	 * `external={true}`. Use in tight layouts (e.g. the mobile header
	 * "Reservar" CTA) where the icon would steal pixels from the label.
	 * The `target="_blank"` + `rel="noopener noreferrer"` behaviour
	 * still applies — only the visual glyph is hidden.
	 */
	hideExternalIcon?: boolean;
}

const {
	variant = 'primary',
	size = 'md',
	as = 'button',
	href,
	type = 'button',
	disabled = false,
	external = false,
	hideExternalIcon = false,
	class: className,
	...rest
} = Astro.props;

const Tag = as;

// When the button is an external link AND the caller hasn't supplied
// their own trailing icon, append a small "external-link" glyph so
// users — especially less tech-savvy ones — anticipate that the click
// opens a new tab. Skipping the auto-glyph when an explicit icon-trailing
// slot is set lets callers like CtaBanner override with their own icon
// (e.g. an arrow) without ending up with two stacked icons. The explicit
// `hideExternalIcon` prop wins over both, for callers who want the
// new-tab behaviour without the visual.
const showExternalIcon =
	external && !hideExternalIcon && !Astro.slots.has('icon-trailing');

const baseClasses =
	'inline-flex items-center justify-center gap-2 font-body font-semibold tracking-tight rounded-full ' +
	'transition-colors duration-fast ' +
	'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background ' +
	'disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none';

const variantClasses: Record<NonNullable<Props['variant']>, string> = {
	primary:
		'button-primary bg-primary text-primary-foreground hover:opacity-90',
	secondary:
		'border border-border text-foreground hover:bg-card hover:border-muted',
	inverse:
		'button-primary bg-primary-foreground text-primary hover:opacity-90 focus-visible:ring-primary-foreground focus-visible:ring-offset-primary',
	ghost: 'text-foreground hover:bg-card',
	onImage:
		'border border-on-image/70 text-on-image hover:bg-on-image/10 hover:border-on-image focus-visible:ring-on-image focus-visible:ring-offset-foreground',
};

const sizeClasses: Record<NonNullable<Props['size']>, string> = {
	sm: 'px-4 py-1.5 text-sm',
	md: 'px-5 py-2.5 text-base',
	lg: 'px-9 py-3.5 text-lg',
};

const tagSpecific =
	as === 'a'
		? {
				href,
				...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
			}
		: { type, ...(disabled ? { disabled: true } : {}) };
---

<Tag
	class:list={[baseClasses, variantClasses[variant], sizeClasses[size], className]}
	{...tagSpecific}
	{...rest}
>
	<slot name="icon-leading" />
	<slot />
	<slot name="icon-trailing" />
	{showExternalIcon && (
		<Icon
			name="tabler:external-link"
			class="h-3.5 w-3.5 opacity-80 shrink-0"
			aria-hidden="true"
		/>
	)}
</Tag>

<style>
	/* Primary button: lift + tinted shadow on hover, micro-press on click.
	   The transform is layered on top of the existing `hover:opacity-90`
	   utility, so the colour stays the same brand primary, just very
	   slightly washed and elevated. */
	.button-primary {
		transition:
			transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 300ms cubic-bezier(0.22, 1, 0.36, 1),
			opacity 150ms ease;
		will-change: transform;
	}

	.button-primary:hover {
		transform: translateY(-1px);
		box-shadow: 0 8px 26px -4px oklch(58% 0.18 54 / 0.38);
	}

	.button-primary:active {
		transform: translateY(0);
		transition-duration: 100ms;
	}

	@media (prefers-reduced-motion: reduce) {
		.button-primary,
		.button-primary:hover,
		.button-primary:active {
			transition: none;
			transform: none;
			box-shadow: none;
		}
	}
</style>
