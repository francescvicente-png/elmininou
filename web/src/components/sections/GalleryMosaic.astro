---
/**
 * Salon gallery mosaic — bento-style 12-column layout with premium hover,
 * shared lightbox indices, and category filtering via `data-gallery-grid` /
 * `data-gallery-item` (see `gallery-filter.ts`).
 */
import type { ImageMetadata } from 'astro';
import type { PhotoLicense } from '../../types/photo-license';
import DemoImage from '../DemoImage.astro';
import { Icon } from 'astro-icon/components';

export interface GalleryMosaicImage {
	src: ImageMetadata;
	alt: string;
	photographer: string;
	photoLicense?: PhotoLicense;
	categories?: ReadonlyArray<string>;
}

interface PullQuote {
	eyebrow: string;
	body: string;
	attribution?: string;
}

interface Props {
	images: ReadonlyArray<GalleryMosaicImage>;
	pullQuote?: PullQuote;
	lightbox?: boolean;
	filterable?: boolean;
	/** Accessible name for the mosaic region */
	ariaLabel: string;
	/** Copy for visually hidden reinforcement next to triggers */
	openFullLabel: string;
	class?: string;
}

/** [colSpan, aspectRatioCSS] — 12-column desktop rhythm; stacks on narrow viewports. */
const PATTERN: ReadonlyArray<[number, string]> = [
	[8, '4/5'],
	[4, '3/4'],
	[4, '5/6'],
	[7, '16/9'],
	[5, '4/5'],
	[6, '3/4'],
	[6, '4/3'],
	[5, '1/1'],
	[7, '3/4'],
	[8, '21/9'],
	[4, '4/5'],
];

const colSpanClass: Record<number, string> = {
	4: 'md:col-span-4',
	5: 'md:col-span-5',
	6: 'md:col-span-6',
	7: 'md:col-span-7',
	8: 'md:col-span-8',
};

const {
	images,
	pullQuote,
	lightbox = false,
	filterable = false,
	ariaLabel,
	openFullLabel,
	class: className,
} = Astro.props;
---

<div
	class:list={['gallery-mosaic', className]}
	role="region"
	aria-label={ariaLabel}
	{...(filterable ? { 'data-gallery-grid': '' } : {})}
>
	<div class="gallery-mosaic__grid gap-5 md:grid md:grid-cols-12 md:gap-[0.62rem]">
		{
			images.flatMap((img, idx) => {
				const [colSpan, aspect] = PATTERN[idx % PATTERN.length];
				const colClass = colSpanClass[colSpan] ?? 'md:col-span-6';

				const rows = [
					(
						<div
							class:list={[
								'gallery-mosaic__cell fade-in-on-scroll rounded-2xl md:justify-self-stretch md:self-stretch',
								colClass,
							]}
							style={{
								'--fade-delay': `${(idx % 5) * 70}ms`,
								'--fade-duration': '720ms',
								'--fade-y': '18px',
							}}
						>
							<div
								class:list={[
									'gallery-mosaic__tile group relative overflow-hidden rounded-2xl',
									'ring-1 ring-[color-mix(in_oklch,var(--color-foreground)_8%,transparent)]',
									'bg-card shadow-[0_26px_64px_-32px_oklch(0%_0_0/0.55)]',
								]}
							>
								<DemoImage
									src={img.src}
									alt={img.alt}
									photographer={img.photographer}
									photoLicense={img.photoLicense ?? 'own'}
									aspectRatio={aspect}
									sizes="(min-width: 1280px) 55vw, (min-width: 768px) 70vw, 100vw"
									loading={idx < 2 ? 'eager' : 'lazy'}
									lightboxIndex={lightbox ? idx : undefined}
									data-gallery-item={filterable ? '' : undefined}
									data-categories={
										filterable && img.categories
											? img.categories.join(' ')
											: undefined
									}
									class="demo-image-gallery-mosaic"
								/>

								{lightbox ? (
									<>
										<div class="gallery-mosaic__shine" aria-hidden="true" />
										<span
											class:list={[
												'gallery-mosaic__glass-icon',
												'hidden md:flex',
											]}
											aria-hidden="true"
										>
											<Icon name="tabler:arrows-maximize" class="h-5 w-5" />
											<span class="sr-only">{openFullLabel}</span>
										</span>
									</>
								) : null}

								<div class="gallery-mosaic__caption">
									<span class="gallery-mosaic__num">{String(idx + 1).padStart(2, '0')}</span>
									<span class="gallery-mosaic__lead">{img.alt}</span>
								</div>
							</div>
						</div>
					),
				];

				if (idx === 1 && pullQuote) {
					rows.push(
						<aside
							class:list={[
								'gallery-mosaic__quote fade-in-on-scroll ring-1 ring-[color-mix(in_oklch,var(--color-foreground)_10%,transparent)] md:col-span-12',
							]}
							style={{ '--fade-delay': '140ms', '--fade-duration': '780ms', '--fade-y': '22px' }}
						>
							<p class="gallery-mosaic__quote-eyebrow">{pullQuote.eyebrow}</p>
							<blockquote class="gallery-mosaic__quote-body">{pullQuote.body}</blockquote>
							{pullQuote.attribution ? (
								<p class="gallery-mosaic__quote-by">— {pullQuote.attribution}</p>
							) : null}
						</aside>,
					);
				}

				return rows;
			})
		}
	</div>
</div>

<style>
	.gallery-mosaic :global([data-gallery-item].is-filtered-out) {
		display: none;
	}

	.demo-image-gallery-mosaic :global(figure.demo-image),
	.gallery-mosaic :global(figure.demo-image) {
		margin: 0;
		border-radius: 0;
	}

	.gallery-mosaic__shine {
		pointer-events: none;
		position: absolute;
		inset: 0;
		z-index: 2;
		border-radius: inherit;
		background: linear-gradient(
			195deg,
			color-mix(in oklch, var(--color-foreground) 16%, transparent) 0%,
			transparent 42%,
			color-mix(in oklch, var(--color-foreground) 38%, transparent) 100%
		);
		opacity: 0;
		transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}

	@media (hover: hover) and (pointer: fine) {
		.gallery-mosaic__tile:hover .gallery-mosaic__shine,
		.gallery-mosaic__tile:focus-within .gallery-mosaic__shine {
			opacity: 1;
		}
	}

	.gallery-mosaic__glass-icon {
		pointer-events: none;
		position: absolute;
		left: 1.1rem;
		top: 1.1rem;
		z-index: 3;
		display: flex;
		height: 2.75rem;
		width: 2.75rem;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		background: color-mix(in oklch, var(--color-background) 92%, transparent);
		color: var(--color-foreground);
		box-shadow:
			0 12px 40px -18px oklch(0% 0 0 / 0.55),
			0 0 0 1px color-mix(in oklch, var(--color-border) 75%, transparent);
		opacity: 0;
		transform: translateY(4px) scale(0.96);
		transition:
			opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}

	@media (hover: hover) and (pointer: fine) {
		.gallery-mosaic__tile:hover .gallery-mosaic__glass-icon,
		.gallery-mosaic__tile:focus-within .gallery-mosaic__glass-icon {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.gallery-mosaic__shine,
		.gallery-mosaic__glass-icon {
			transition: none;
		}
		.gallery-mosaic__tile:hover .gallery-mosaic__glass-icon,
		.gallery-mosaic__tile:focus-within .gallery-mosaic__glass-icon {
			transform: none;
		}
	}

	.gallery-mosaic__caption {
		display: flex;
		gap: 0.75rem;
		align-items: baseline;
		padding: 0.85rem 1rem 1.05rem;
		font-family: var(--font-body), system-ui, sans-serif;
	}

	.gallery-mosaic__num {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		color: var(--color-primary);
		font-variant-numeric: tabular-nums;
	}

	.gallery-mosaic__lead {
		font-size: 0.8rem;
		line-height: 1.5;
		color: var(--color-muted);
		max-width: 38ch;
	}

	.gallery-mosaic__quote {
		margin: 0.25rem 0 0.35rem;
		display: grid;
		gap: 1.2rem;
		padding: 2.75rem 1.75rem;
		border-radius: 1.75rem;
		background: color-mix(in oklch, var(--color-card) 92%, var(--color-background));
		box-shadow:
			0 22px 60px -36px oklch(0% 0 0 / 0.45),
			inset 0 0 0 1px color-mix(in oklch, var(--color-foreground) 8%, transparent);
	}

	@media (min-width: 768px) {
		.gallery-mosaic__quote {
			grid-template-columns: minmax(0, 1fr) minmax(0, 3.2fr) minmax(0, 0.8fr);
			gap: 2rem;
			align-items: start;
			padding: 3.5rem 2.75rem;
		}
	}

	.gallery-mosaic__quote-eyebrow {
		margin: 0;
		font-family: var(--font-body), system-ui, sans-serif;
		font-size: 0.68rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.32em;
		color: var(--color-primary);
	}

	.gallery-mosaic__quote-body {
		margin: 0;
		font-family: var(--font-display), Georgia, serif;
		font-style: italic;
		font-size: clamp(1.45rem, 2.1vw + 0.55rem, 2.55rem);
		line-height: 1.22;
		color: var(--color-foreground);
		text-wrap: balance;
		max-width: 36ch;
	}

	.gallery-mosaic__quote-by {
		margin: 0;
		font-family: var(--font-body), system-ui, sans-serif;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--color-muted);
		align-self: end;
	}
</style>
