---
/**
 * In-page pills linking to grouped menu sections.
 */
import type { Lang } from '../../i18n/config';
import type { UIKey } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import {
	type ServiceCategoryKey,
	type ServiceGroup,
	serviceCategoryAnchorId,
} from '../../data/services';

interface Props {
	lang: Lang;
	groups: ReadonlyArray<ServiceGroup>;
	class?: string;
}

const { lang, groups, class: className } = Astro.props;
const t = useTranslations(lang);

const categoryLabelKey: Record<ServiceCategoryKey, UIKey> = {
	starters: 'services.categoryStarters',
	grills: 'services.categoryGrills',
	pasta: 'services.categoryPasta',
	combos: 'services.categoryCombos',
	'sandwiches-hot': 'services.categorySandwichesHot',
	'sandwiches-cold': 'services.categorySandwichesCold',
	tapas: 'services.categoryTapas',
	drinks: 'services.categoryDrinks',
};
---

<nav
	class:list={['services-cat-nav', className]}
	aria-label={t('services.jumpNavAria')}
>
	<ul class="flex flex-wrap gap-2 md:gap-2.5">
		{
			groups.map(({ category }) => (
				<li>
					<a
						class="services-cat-nav-link inline-flex items-center rounded-full border border-border/95 bg-card/95 px-3.5 py-2 font-body text-xs font-semibold uppercase tracking-[0.13em] text-foreground shadow-sm transition-[transform,background-color,border-color,box-shadow] duration-normal ease-standard hover:border-primary/50 hover:bg-backgroundAlt hover:shadow-[0_6px_20px_-8px_oklch(40%_0.12_52/0.45)] hover:-translate-y-px motion-reduce:transform-none motion-reduce:transition-none active:translate-y-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
						href={`#${serviceCategoryAnchorId(category)}`}
					>
						{t(categoryLabelKey[category])}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	@media (prefers-reduced-motion: reduce) {
		.services-cat-nav-link {
			transition: none;
		}

		.services-cat-nav-link:hover,
		.services-cat-nav-link:active {
			transform: none;
		}
	}
</style>
