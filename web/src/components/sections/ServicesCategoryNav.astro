---
/**
 * In-page pills linking to grouped menu sections.
 */
import type { Lang } from '../../i18n/config';
import type { UIKey } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import {
	type ServiceCategoryKey,
	type ServiceGroup,
	serviceCategoryAnchorId,
} from '../../data/services';

interface Props {
	lang: Lang;
	groups: ReadonlyArray<ServiceGroup>;
	class?: string;
}

const { lang, groups, class: className } = Astro.props;
const t = useTranslations(lang);

const categoryLabelKey: Record<ServiceCategoryKey, UIKey> = {
	starters: 'services.categoryStarters',
	grills: 'services.categoryGrills',
	pasta: 'services.categoryPasta',
	combos: 'services.categoryCombos',
	'sandwiches-hot': 'services.categorySandwichesHot',
	'sandwiches-cold': 'services.categorySandwichesCold',
	tapas: 'services.categoryTapas',
	drinks: 'services.categoryDrinks',
};
---

<nav
	class:list={['services-cat-nav', className]}
	aria-label={t('services.jumpNavAria')}
>
	<ul class="flex flex-wrap gap-2 md:gap-2.5">
		{
			groups.map(({ category }) => (
				<li>
					<a
						class="services-cat-nav-link inline-flex items-center rounded-full border border-border bg-card px-3.5 py-2 font-body text-xs font-medium uppercase tracking-[0.12em] text-foreground/88 transition-colors hover:border-primary/45 hover:bg-backgroundAlt hover:text-foreground"
						href={`#${serviceCategoryAnchorId(category)}`}
					>
						{t(categoryLabelKey[category])}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	@media (prefers-reduced-motion: reduce) {
		.services-cat-nav-link {
			transition: none;
		}
	}
</style>
