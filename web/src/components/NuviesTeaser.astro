---
/**
 * Editorial banner on the home linking to the full bridal landing page.
 */
import { Icon } from 'astro-icon/components';
import Heading from './Heading.astro';
import Button from './Button.astro';
import Container from './Container.astro';
import { getRoutePair } from '../i18n/routes';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/config';

interface Props {
	lang: Lang;
	class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);
const bridalHref = getRoutePair('bridal')[lang];
---

<Container>
<aside
	class:list={[
		'nuvies-teaser rounded-xl p-6 md:p-8 flex flex-col md:flex-row md:items-center gap-6 backdrop-blur-md shadow-lg shadow-black/25',
		className,
	]}
>
	<div class="flex items-start gap-4 md:gap-5 flex-1">
		<Icon
			name="tabler:heart"
			class="h-10 w-10 text-primary shrink-0 mt-0.5 drop-shadow-[0_1px_4px_rgba(0,0,0,0.45)]"
			aria-hidden="true"
		/>
		<div class="space-y-2">
			<p
				class="text-xs uppercase tracking-widest font-body text-on-image/80 drop-shadow-[0_1px_6px_rgba(0,0,0,0.5)]"
			>
				{t('bridal.teaserEyebrow')}
			</p>
			<Heading as="h2" size="h4" class="!text-on-image drop-shadow-[0_2px_10px_rgba(0,0,0,0.55)]">
				{t('bridal.teaserHeading')}
			</Heading>
			<p
				class="text-sm font-body text-on-image/90 leading-relaxed max-w-prose drop-shadow-[0_1px_8px_rgba(0,0,0,0.5)]"
			>
				{t('bridal.teaserBody')}
			</p>
		</div>
	</div>
	<Button as="a" href={bridalHref} variant="primary" size="md" class="shrink-0 w-full md:w-auto">
		{t('bridal.teaserCta')}
		<Icon
			slot="icon-trailing"
			name="tabler:chevron-right"
			class="h-4 w-4"
			aria-hidden="true"
		/>
	</Button>
</aside>
</Container>

<style>
	/**
	 * Glass panel over the fixed hero — same language as ReviewCard `onImage`
	 * (backdrop blur + translucent fill), but tinted deep aubergine/lilac so it
	 * reads as brand-owned next to the cream review cards in post-gallery hero.
	 */
	.nuvies-teaser {
		background-color: oklch(15% 0.06 308 / 0.52);
		border: 1px solid color-mix(in oklch, var(--color-primary) 42%, transparent);
		transition:
			transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 400ms cubic-bezier(0.22, 1, 0.36, 1),
			border-color 400ms cubic-bezier(0.22, 1, 0.36, 1),
			background-color 400ms ease;
		will-change: transform;
	}

	.nuvies-teaser:hover {
		transform: translateY(-4px);
		background-color: oklch(16% 0.065 308 / 0.6);
		box-shadow:
			0 12px 32px -8px oklch(0% 0 0 / 0.35),
			0 0 0 1px color-mix(in oklch, var(--color-primary) 22%, transparent);
		border-color: color-mix(in oklch, var(--color-primary) 58%, transparent);
	}

	@media (prefers-reduced-motion: reduce) {
		.nuvies-teaser,
		.nuvies-teaser:hover {
			transition: none;
			transform: none;
			box-shadow: 0 12px 40px -12px oklch(0% 0 0 / 0.3);
		}
	}
</style>
