---
/**
 * BridalLanding — composition of the (currently disabled) bridal
 * landings. The route is not part of El mini nou's active sitemap
 * (see CLAUDE.md §3.5); this file remains as plantilla scaffolding.
 *
 * Sections:
 *   1. BridalHero            — asymmetric split, portrait + display type
 *   2. BridalEditorialIntro  — typographic statement + 2 detail photos
 *   3. BridalProcess         — editorial timeline (4 steps, vertical hairline)
 *   4. BridalPackages        — spotlight + 2 supporting (anti-3-equal-cards)
 *   5. BridalGallery         — gapless asymmetric bento (5 images)
 *   6. BridalFaqBlock        — eyebrow + headline + existing FaqList
 *   7. BridalCtaClosing      — champagne accent banner, paired CTAs
 *
 * The previous "BridalTestimonial" pull-quote was removed: it surfaced
 * a fabricated quote ("Texto ejemplo" / "Família habitual al
 * municipi") that was never a real review. Authentic reviews live in
 * `data/reviews.ts` and render through `ReviewsBentoSection`.
 */
import type { Lang } from '../i18n/config';
import BridalHero from './bridal/BridalHero.astro';
import BridalEditorialIntro from './bridal/BridalEditorialIntro.astro';
import BridalProcess from './bridal/BridalProcess.astro';
import BridalPackages from './bridal/BridalPackages.astro';
import BridalGallery from './bridal/BridalGallery.astro';
import BridalFaqBlock from './bridal/BridalFaqBlock.astro';
import BridalCtaClosing from './bridal/BridalCtaClosing.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
---

<BridalHero lang={lang} />
<BridalEditorialIntro lang={lang} />
<BridalProcess lang={lang} />
<BridalPackages lang={lang} />
<BridalGallery lang={lang} />
<BridalFaqBlock lang={lang} />
<BridalCtaClosing lang={lang} />
