---
import '../../styles/global.css';
import { Font } from 'astro:assets';
import Button from '../Button.astro';
import Heading from '../Heading.astro';
import Text from '../Text.astro';
import Container from '../Container.astro';
import Card from '../Card.astro';
import Link from '../Link.astro';
import Badge from '../Badge.astro';
import Section from '../Section.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../../data/business';

const semanticColors = [
	{ token: 'background', desc: 'Fondo de página' },
	{ token: 'foreground', desc: 'Texto principal' },
	{ token: 'muted', desc: 'Texto secundario' },
	{ token: 'border', desc: 'Bordes sutiles y separadores' },
	{ token: 'card', desc: 'Fondo de cards' },
	{ token: 'primary', desc: 'Acento de marca (verde botella)' },
	{ token: 'primary-foreground', desc: 'Texto sobre primary' },
];

const spacingTokens = [
	{ px: '1px', utility: 'p-px' },
	{ px: '2px', utility: 'p-0.5' },
	{ px: '4px', utility: 'p-1' },
	{ px: '8px', utility: 'p-2' },
	{ px: '16px', utility: 'p-4' },
	{ px: '32px', utility: 'p-8' },
	{ px: '64px', utility: 'p-16' },
];
---

<html lang="ca">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex, nofollow" />
		<title>{`Styleguide · ${business.name} (dev)`}</title>
		<Font cssVariable="--font-playfair-display-sc" preload />
		<Font cssVariable="--font-karla" preload />
	</head>
	<body class="min-h-screen">
		<Container as="main" class="py-12 md:py-16 space-y-20">
			<header class="space-y-4 border-b border-border pb-10">
				<Badge variant="outline">Dev styleguide</Badge>
				<Heading as="h1" size="h2">Sistema visual</Heading>
				<Text variant="lead">
					Inspección de tokens y componentes base. Página solo accesible en desarrollo; en producción retorna 404.
				</Text>
			</header>

			<Section class="!py-0 space-y-6">
				<div class="space-y-2">
					<Heading as="h2" size="h3">Tokens semánticos</Heading>
					<Text variant="small">
						Los componentes deben usar SOLO estos tokens.
					</Text>
				</div>
				<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
					{
						semanticColors.map(({ token, desc }) => (
							<Card>
								<div class="flex items-center gap-4">
									<div
										class="h-12 w-12 rounded-md border border-border shrink-0"
										style={`background-color: var(--color-${token});`}
										aria-hidden="true"
									/>
									<div class="space-y-0.5 min-w-0">
										<div class="font-mono text-sm text-foreground truncate">--color-{token}</div>
										<div class="text-xs text-muted">{desc}</div>
									</div>
								</div>
							</Card>
						))
					}
				</div>
			</Section>

			<Section class="!py-0 space-y-8">
				<div class="space-y-2">
					<Heading as="h2" size="h3">Tipografía</Heading>
					<Text variant="small">Cormorant Garamond (display) + Inter (body). Display 400-700 con itálica; body 400 y 700.</Text>
				</div>

				<Card class="space-y-6">
					<div class="space-y-1">
						<Text variant="caption">Display · h1</Text>
						<Heading as="h1">{business.name}</Heading>
					</div>
					<div class="space-y-1">
						<Text variant="caption">Display · h2</Text>
						<Heading as="h2">Tradició i ofici</Heading>
					</div>
					<div class="space-y-1">
						<Text variant="caption">Display · h3</Text>
						<Heading as="h3">Menú revisat cada setmana amb el servei</Heading>
					</div>
					<div class="space-y-1">
						<Text variant="caption">Display · h4</Text>
						<Heading as="h4">Reserva taula per telèfon</Heading>
					</div>
					<div class="space-y-1">
						<Text variant="caption">Body · lead</Text>
						<Text variant="lead">
							Restaurant i bar a {business.address.city}. Brases, tapes i carta clara; atenció directa al local.
						</Text>
					</div>
					<div class="space-y-1">
						<Text variant="caption">Body · normal</Text>
						<Text>
							The quick brown fox jumps over the lazy dog. Texto de prueba para validar legibilidad y métricas tipográficas con caracteres acentuados (áéíóú, ñç).
						</Text>
					</div>
					<div class="space-y-1">
						<Text variant="caption">Body · small</Text>
						<Text variant="small">
							Texto secundario. Se usa para descripciones cortas, notas al pie y leyendas auxiliares.
						</Text>
					</div>
					<div class="space-y-1">
						<Text variant="caption">Body · caption (este texto es caption)</Text>
					</div>
				</Card>
			</Section>

			<Section class="!py-0 space-y-6">
				<div class="space-y-2">
					<Heading as="h2" size="h3">Espaciado</Heading>
					<Text variant="small">Escala estándar de Tailwind.</Text>
				</div>
				<Card class="space-y-4">
					{
						spacingTokens.map(({ px, utility }) => (
							<div class="flex items-center gap-4">
								<div
									class="bg-primary shrink-0"
									style={`width: ${px}; height: ${px};`}
									aria-hidden="true"
								/>
								<div class="font-mono text-sm text-foreground">{utility}</div>
								<div class="font-mono text-xs text-muted">{px}</div>
							</div>
						))
					}
				</Card>
			</Section>

			<Section class="!py-0 space-y-6">
				<div class="space-y-2">
					<Heading as="h2" size="h3">Border radius</Heading>
				</div>
				<div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
					<div class="flex flex-col items-center gap-3">
						<div class="h-24 w-24 bg-primary rounded-sm" aria-hidden="true"></div>
						<div class="text-center">
							<div class="font-mono text-sm text-foreground">rounded-sm</div>
							<div class="font-mono text-xs text-muted">4px</div>
						</div>
					</div>
					<div class="flex flex-col items-center gap-3">
						<div class="h-24 w-24 bg-primary rounded-md" aria-hidden="true"></div>
						<div class="text-center">
							<div class="font-mono text-sm text-foreground">rounded-md</div>
							<div class="font-mono text-xs text-muted">8px</div>
						</div>
					</div>
					<div class="flex flex-col items-center gap-3">
						<div class="h-24 w-24 bg-primary rounded-lg" aria-hidden="true"></div>
						<div class="text-center">
							<div class="font-mono text-sm text-foreground">rounded-lg</div>
							<div class="font-mono text-xs text-muted">12px</div>
						</div>
					</div>
					<div class="flex flex-col items-center gap-3">
						<div class="h-24 w-24 bg-primary rounded-full" aria-hidden="true"></div>
						<div class="text-center">
							<div class="font-mono text-sm text-foreground">rounded-full</div>
							<div class="font-mono text-xs text-muted">9999px</div>
						</div>
					</div>
				</div>
			</Section>

			<Section class="!py-0 space-y-6">
				<div class="space-y-2">
					<Heading as="h2" size="h3">Sombras</Heading>
				</div>
				<div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
					<div class="flex flex-col items-center gap-3">
						<div class="h-24 w-full bg-card rounded-lg shadow-sm" aria-hidden="true"></div>
						<div class="font-mono text-sm text-foreground">shadow-sm</div>
					</div>
					<div class="flex flex-col items-center gap-3">
						<div class="h-24 w-full bg-card rounded-lg shadow-md" aria-hidden="true"></div>
						<div class="font-mono text-sm text-foreground">shadow-md</div>
					</div>
					<div class="flex flex-col items-center gap-3">
						<div class="h-24 w-full bg-card rounded-lg shadow-lg" aria-hidden="true"></div>
						<div class="font-mono text-sm text-foreground">shadow-lg</div>
					</div>
				</div>
			</Section>

			<Section class="!py-0 space-y-12">
				<div class="space-y-2">
					<Heading as="h2" size="h3">Componentes base</Heading>
					<Text variant="small">Estado por defecto, hover y focus visibles al interactuar (Tab para focus).</Text>
				</div>

				<div class="space-y-4">
					<Heading as="h3" size="h4">Button</Heading>
					<Card class="space-y-6">
						<div class="space-y-2">
							<Text variant="caption">Variants × sizes</Text>
							<div class="flex flex-wrap items-center gap-3">
								<Button variant="primary" size="sm">Reservar</Button>
								<Button variant="primary" size="md">Reservar</Button>
								<Button variant="primary" size="lg">Reservar</Button>
							</div>
							<div class="flex flex-wrap items-center gap-3">
								<Button variant="secondary" size="sm">Saber més</Button>
								<Button variant="secondary" size="md">Saber més</Button>
								<Button variant="secondary" size="lg">Saber més</Button>
							</div>
							<div class="flex flex-wrap items-center gap-3">
								<Button variant="ghost" size="sm">Cancel·lar</Button>
								<Button variant="ghost" size="md">Cancel·lar</Button>
								<Button variant="ghost" size="lg">Cancel·lar</Button>
							</div>
						</div>
						<div class="space-y-2">
							<Text variant="caption">Estados</Text>
							<div class="flex flex-wrap items-center gap-3">
								<Button variant="primary" disabled>Disabled primary</Button>
								<Button variant="secondary" disabled>Disabled secondary</Button>
							</div>
						</div>
						<div class="space-y-2">
							<Text variant="caption">Con icono</Text>
							<div class="flex flex-wrap items-center gap-3">
								<Button variant="primary">
									<Icon slot="icon-leading" name="tabler:check" class="h-4 w-4" />
									Confirmar
								</Button>
								<Button variant="secondary">
									Següent
									<Icon slot="icon-trailing" name="tabler:chevron-right" class="h-4 w-4" />
								</Button>
							</div>
						</div>
						<div class="space-y-2">
							<Text variant="caption">Como enlace (as=&quot;a&quot;)</Text>
							<div class="flex flex-wrap items-center gap-3">
								<Button as="a" href="#" variant="primary">Link como botón</Button>
								<Button as="a" href="https://example.com" variant="secondary" external>
									Externo
									<Icon slot="icon-trailing" name="tabler:arrow-up-right" class="h-4 w-4" />
								</Button>
							</div>
						</div>
					</Card>
				</div>

				<div class="space-y-4">
					<Heading as="h3" size="h4">Heading</Heading>
					<Card class="space-y-4">
						<Heading as="h1">Heading h1</Heading>
						<Heading as="h2">Heading h2</Heading>
						<Heading as="h3">Heading h3</Heading>
						<Heading as="h4">Heading h4</Heading>
						<div class="pt-4 border-t border-border space-y-2">
							<Text variant="caption">Override de tamaño (h2 con tamaño h4)</Text>
							<Heading as="h2" size="h4">Heading h2 visualmente h4</Heading>
						</div>
					</Card>
				</div>

				<div class="space-y-4">
					<Heading as="h3" size="h4">Text</Heading>
					<Card class="space-y-3">
						<Text variant="lead">Variante lead. Texto de entrada de bloque.</Text>
						<Text variant="body">Variante body. El cuerpo principal de párrafos largos.</Text>
						<Text variant="small">Variante small. Para descripciones secundarias o notas auxiliares.</Text>
						<Text variant="caption">Variante caption</Text>
					</Card>
				</div>

				<div class="space-y-4">
					<Heading as="h3" size="h4">Card</Heading>
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						<Card>
							<Heading as="h4">Card simple</Heading>
							<Text class="mt-2">Sin estado hover. Para contenidos estáticos.</Text>
						</Card>
						<Card hoverable>
							<Heading as="h4">Card hoverable</Heading>
							<Text class="mt-2">Con borde animado al pasar el cursor. Para tarjetas clicables.</Text>
						</Card>
					</div>
				</div>

				<div class="space-y-4">
					<Heading as="h3" size="h4">Link</Heading>
					<Card class="space-y-4">
						<Text>
							Esto es un párrafo con un <Link href="#">enlace inline</Link> dentro del texto, junto con un <Link href="https://example.com" external>enlace externo inline</Link>.
						</Text>
						<div class="flex flex-col items-start gap-2">
							<Link href="#" variant="standalone">Enlace standalone</Link>
							<Link href="https://example.com" variant="standalone" external>Enlace standalone externo</Link>
						</div>
					</Card>
				</div>

				<div class="space-y-4">
					<Heading as="h3" size="h4">Badge</Heading>
					<Card>
						<div class="flex flex-wrap items-center gap-3">
							<Badge>Default</Badge>
							<Badge variant="outline">Outline</Badge>
							<Badge>Nou</Badge>
							<Badge variant="outline">Beta</Badge>
						</div>
					</Card>
				</div>
			</Section>
		</Container>
	</body>
</html>
