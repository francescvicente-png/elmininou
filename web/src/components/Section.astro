---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
	as?: 'section' | 'div';
}

const { as = 'section', class: className, ...rest } = Astro.props;

const Tag = as;
---

<Tag class:list={['py-20 md:py-24', className]} {...rest}>
	<slot />
</Tag>
