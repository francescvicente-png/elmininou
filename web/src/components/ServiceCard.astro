---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ServiceIcon from './icons/ServiceIcon.astro';
import DrawnBorder from './decorative/DrawnBorder.astro';
import Heading from './Heading.astro';
import Badge from './Badge.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

type HeadingLevel = 'h2' | 'h3' | 'h4';

interface Props {
	name: string;
	description: string;
	/** When `null`, shows `pricePendingLabel` instead of a formatted amount. */
	duration: number;
	price: number | null;
	icon?: string;
	/** Editorial / drawn thumbnail; when set, the tabler icon is omitted to avoid redundancy. */
	illustration?: ImageMetadata;
	/** Descriptive alt for the illustration (required for WCAG when the image carries meaning). */
	illustrationAlt?: string;
	/** First above-the-fold card on /serveis/ should pass `high` so LCP starts early. */
	imageFetchPriority?: 'high' | 'low' | 'auto';
	featured?: boolean;
	class?: string;
	/**
	 * Visual size. Drives padding, heading scale and description size
	 * so the same card composes at different scales in the magazine
	 * grid (`lg` for the feature, `md` default, `sm` for the lower
	 * row of three). The DATA is identical at every size — only the
	 * presentation scales.
	 */
	size?: 'sm' | 'md' | 'lg';
	/**
	 * Semantic heading level. Pages where the cards are the *primary*
	 * content under an h1 should pass `h2` so the document outline is
	 * h1 → h2 (no skip). Default h3 fits home / preview contexts where
	 * the cards live under an h2 section heading.
	 */
	headingLevel?: HeadingLevel;
	/**
	 * When true, shows a compact badge — tariff/detail still pending
	 * salon confirmation (business owner).
	 */
	pendingConfirmation?: boolean;
	/** When set, the illustration becomes a lightbox trigger opening at this index. */
	lightboxIndex?: number;
}

const {
	name,
	description,
	duration,
	price,
	icon,
	illustration,
	illustrationAlt,
	imageFetchPriority = 'auto',
	featured = false,
	class: className,
	size = 'md',
	headingLevel = 'h3',
	pendingConfirmation = false,
	lightboxIndex,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sizeClasses: Record<NonNullable<Props['size']>, {
	wrapper: string;
	icon: string;
	heading: string;
	desc: string;
	footer: string;
}> = {
	sm: {
		wrapper: 'p-5',
		icon: 'h-6 w-6 mb-3',
		heading: '!text-xl !md:text-xl',
		desc: 'mt-2 text-sm',
		footer: 'mt-4 pt-4 text-sm',
	},
	md: {
		wrapper: 'p-6',
		icon: 'h-7 w-7 mb-4',
		heading: '!text-2xl !md:text-2xl',
		desc: 'mt-2 text-base',
		footer: 'mt-6 pt-6 text-sm',
	},
	lg: {
		wrapper: 'p-8 md:p-10',
		icon: 'h-9 w-9 mb-6',
		heading: '!text-3xl !md:text-4xl',
		desc: 'mt-3 text-lg',
		footer: 'mt-8 pt-8 text-base',
	},
};
const sizes = sizeClasses[size];
const showIcon = Boolean(icon) && !illustration;
const imageAlt = illustration ? (illustrationAlt?.trim() || '') : '';
const imageLoading = imageFetchPriority === 'high' ? 'eager' : 'lazy';

const priceFormatter =
	price === null
		? null
		: new Intl.NumberFormat('es-ES', {
				style: 'currency',
				currency: 'EUR',
				maximumFractionDigits: price % 1 === 0 ? 0 : 2,
			});
const showDuration = duration > 0;

/** Responsive slots for mosaic + services grid (matches ProductCard). */
const pictureSizes =
	'(min-width: 1024px) 28vw, (min-width: 768px) 45vw, 90vw';
---

<article
	class:list={[
		'service-card drawn-border-host relative flex flex-col h-full overflow-hidden rounded-xl border p-0',
		featured
			? 'border-primary bg-card'
			: 'border-border bg-card',
		className,
	]}
>
	<DrawnBorder />
	{
		illustration && lightboxIndex !== undefined ? (
			<button
				type="button"
				class:list={[
					'service-card-figure service-card-figure--trigger group relative w-full shrink-0 overflow-hidden bg-[color-mix(in_oklch,var(--color-muted)_12%,var(--color-background))]',
					'aspect-[4/3] lg:aspect-auto lg:min-h-[13rem] lg:flex-1',
					'cursor-zoom-in border-0 p-0 text-left',
				]}
				data-lightbox-trigger
				data-lightbox-index={lightboxIndex}
				aria-label={`${t('gallery.openImage')}: ${name}`}
			>
				<Picture
					src={illustration}
					alt={imageAlt}
					formats={['avif', 'webp']}
					class="pointer-events-none absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
					loading={imageLoading}
					decoding="async"
					fetchpriority={imageFetchPriority}
					sizes={pictureSizes}
				/>
				<div class="service-card-figure-scrim pointer-events-none absolute inset-0" aria-hidden="true" />
				<span class="service-card-zoom-hint pointer-events-none absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-full bg-black/40 text-white opacity-0 backdrop-blur-sm transition-opacity duration-200 group-hover:opacity-100" aria-hidden="true">
					<Icon name="tabler:zoom-in" class="h-4 w-4" />
				</span>
			</button>
		) : illustration ? (
			<div
				class:list={[
					'service-card-figure relative w-full shrink-0 overflow-hidden bg-[color-mix(in_oklch,var(--color-muted)_12%,var(--color-background))]',
					'aspect-[4/3] lg:aspect-auto lg:min-h-[13rem] lg:flex-1',
				]}
			>
				<Picture
					src={illustration}
					alt={imageAlt}
					formats={['avif', 'webp']}
					class="pointer-events-none absolute inset-0 size-full object-cover"
					loading={imageLoading}
					decoding="async"
					fetchpriority={imageFetchPriority}
					sizes={pictureSizes}
				/>
				<div class="service-card-figure-scrim pointer-events-none absolute inset-0" aria-hidden="true" />
			</div>
		) : null
	}
	<div
		class:list={[
			sizes.wrapper,
			'flex min-h-0 flex-col',
			/* Icon-only (or no hero image): allow footer to sit at card bottom when the
			   grid stretches the cell. With an illustration, the figure flexes instead. */
			illustration ? 'shrink-0' : 'flex-1',
		]}
	>
		{
			pendingConfirmation && (
				<Badge variant="outline" class="mb-3 self-start">
					{t('services.pendingBadge')}
				</Badge>
			)
		}
		{
			showIcon && icon && (
				<ServiceIcon name={icon} class:list={['text-primary', sizes.icon]} />
			)
		}
		<Heading as={headingLevel} size="h3" class={`tracking-tight ${sizes.heading}`}>
			{name}
		</Heading>
		<p class:list={['text-muted leading-relaxed', sizes.desc]}>{description}</p>
		<dl
			class:list={[
				/* dt uses foreground at ~78% so ~10px uppercase still clears WCAG AA
				   against `bg-card` (small text needs ≥4.5:1; theme `text-muted` is OK
				   on large copy but is tight at this optical size on charcoal). */
				'border-t border-border mt-auto gap-x-4 gap-y-1 font-body',
				showDuration ? 'grid grid-cols-2' : 'grid grid-cols-1',
				sizes.footer,
			]}
		>
			{
				showDuration && (
					<div class="min-w-0 space-y-1">
						<dt class="text-[0.65rem] font-medium uppercase tracking-[0.14em] text-foreground/78">
							{t('services.durationLabel')}
						</dt>
						<dd class="m-0 tabular-nums text-foreground">{duration} min</dd>
					</div>
				)
			}
			<div class:list={['min-w-0 space-y-1', showDuration && 'text-right']}>
				<dt class="text-[0.65rem] font-medium uppercase tracking-[0.14em] text-foreground/78">
					{t('services.priceFromLabel')}
				</dt>
				<dd class="m-0 font-semibold tabular-nums text-foreground">
					{priceFormatter && price !== null ? priceFormatter.format(price) : t('menu.pricePending')}
				</dd>
			</div>
		</dl>
	</div>
</article>

<style>
	/* Editorial “material” surface: top hairline (inset) + tinted outer lift on
	   hover. Hue follows primary so shadows never read as default grey slop on
	   the charcoal shell (taste-skill: tint shadows to the scene). */
	.service-card {
		box-shadow:
			0 1px 0 0 oklch(98% 0.01 85 / 0.04) inset,
			0 0 0 1px oklch(0% 0 0 / 0.12) inset,
			0 4px 20px -6px oklch(0% 0 0 / 0.45);
		transition:
			transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
			box-shadow 420ms cubic-bezier(0.16, 1, 0.3, 1),
			border-color 420ms cubic-bezier(0.16, 1, 0.3, 1);
		will-change: transform;
	}

	.service-card-figure-scrim {
		background: linear-gradient(
			to top,
			color-mix(in oklch, var(--color-card) 88%, transparent) 0%,
			color-mix(in oklch, var(--color-card) 20%, transparent) 42%,
			transparent 72%
		);
	}

	.service-card:hover {
		transform: translateY(-5px);
		box-shadow:
			0 1px 0 0 oklch(98% 0.01 85 / 0.07) inset,
			0 0 0 1px oklch(58% 0.14 42 / 0.22) inset,
			0 18px 40px -10px oklch(26% 0.09 42 / 0.38);
		border-color: color-mix(in oklch, var(--color-primary) 70%, var(--color-border));
	}

	.service-card.border-primary:hover {
		border-color: var(--color-primary);
	}

	.service-card:active {
		transform: translateY(-2px) scale(0.992);
		transition-duration: 120ms;
	}

	@media (prefers-reduced-motion: reduce) {
		.service-card {
			box-shadow:
				0 1px 0 0 oklch(98% 0.01 85 / 0.04) inset,
				0 0 0 1px oklch(0% 0 0 / 0.12) inset,
				0 4px 20px -6px oklch(0% 0 0 / 0.45);
		}

		.service-card,
		.service-card:hover,
		.service-card:active {
			transition: none;
			transform: none;
			box-shadow:
				0 1px 0 0 oklch(98% 0.01 85 / 0.04) inset,
				0 0 0 1px oklch(0% 0 0 / 0.12) inset,
				0 4px 20px -6px oklch(0% 0 0 / 0.45);
		}
	}
</style>
