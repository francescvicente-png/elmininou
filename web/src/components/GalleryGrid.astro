---
import type { ImageMetadata } from 'astro';
import type { PhotoLicense } from '../types/photo-license';
import DemoImage from './DemoImage.astro';

export interface GalleryImage {
	src: ImageMetadata;
	alt: string;
	photographer: string;
	photoLicense?: PhotoLicense;
	/** Optional list of category ids — used by the gallery filter to
	 *  show/hide items. Empty array = always visible regardless of
	 *  filter choice. */
	categories?: ReadonlyArray<string>;
}

interface Props {
	images: ReadonlyArray<GalleryImage>;
	columns?: 2 | 3 | 4;
	class?: string;
	/**
	 * If true, each gallery item gets `.fade-in-on-scroll` with a
	 * per-index transition-delay so they reveal as a cascade. Used on the
	 * dedicated gallery pages; off (default) on the home preview where a
	 * cascade competes with the section fade-in.
	 */
	cascade?: boolean;
	/** Stagger between items in ms (only applies when `cascade` is true). */
	cascadeStep?: number;
	/**
	 * If true, each <DemoImage> becomes a lightbox trigger via its
	 * `lightboxIndex` prop. The page that uses this grid must also
	 * mount a <GalleryLightbox> with the matching `images`.
	 */
	lightbox?: boolean;
	/**
	 * If true, each item carries `data-gallery-item` and
	 * `data-categories`, which the filter script reads to show/hide
	 * cards as the user clicks a filter pill. Independent of `cascade`.
	 */
	filterable?: boolean;
}

const {
	images,
	columns = 3,
	class: className,
	cascade = false,
	cascadeStep = 80,
	lightbox = false,
	filterable = false,
} = Astro.props;

// Aspect ratios alternated by index for a pseudo-masonry rhythm.
const aspectVariants = ['1/1', '3/4', '4/3'] as const;

// Tailwind needs the literal classes in source for JIT detection.
const colsClass: Record<2 | 3 | 4, string> = {
	2: 'lg:grid-cols-2',
	3: 'lg:grid-cols-3',
	4: 'lg:grid-cols-4',
};
---

<div
	class:list={[
		'gallery-grid grid grid-cols-1 sm:grid-cols-2 gap-4',
		colsClass[columns],
		className,
	]}
	{...(filterable ? { 'data-gallery-grid': '' } : {})}
>
	{
		images.map((img, idx) => {
			const categoriesAttr =
				filterable && img.categories ? img.categories.join(' ') : undefined;
			return (
				<DemoImage
					src={img.src}
					alt={img.alt}
					photographer={img.photographer}
					photoLicense={img.photoLicense ?? 'own'}
					aspectRatio={aspectVariants[idx % aspectVariants.length]}
					sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
					class={cascade ? 'fade-in-on-scroll' : undefined}
					style={
						cascade
							? `--fade-delay: ${idx * cascadeStep}ms; --fade-duration: 600ms; --fade-y: 24px;`
							: undefined
					}
					lightboxIndex={lightbox ? idx : undefined}
					data-gallery-item={filterable ? '' : undefined}
					data-categories={categoriesAttr}
				/>
			);
		})
	}
</div>

<style>
	/* Filter visibility — applied to items whose data-categories does
	   NOT match the current filter. The gallery-filter.ts script adds
	   this class on click; CSS handles the smooth fade out + collapse. */
	.gallery-grid :global([data-gallery-item].is-filtered-out) {
		display: none;
	}
</style>
