---
/**
 * Editorial showcase of 3 signature dishes — the "lead" before the full catalog.
 *
 * Magazine-style asymmetric grid: one hero card (col-span-7) plus two stacked
 * cards (col-span-5). Pulls the dishes from `SIGNATURE_DISH_IDS` and uses the
 * same image map as the rest of the carta. Falls back gracefully when an
 * illustration is missing.
 */
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { Lang } from '../../i18n/config';
import {
	getSignatureDishes,
	getServiceName,
	getServiceDescription,
	getDishTags,
} from '../../data/services';
import { MENU_DISH_ILLUSTRATIONS } from '../../data/menu-illustrations';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const dishes = getSignatureDishes();

const copy = {
	ca: {
		eyebrow: 'Plats firma',
		title: 'Tres clàssics. Cap excusa.',
		lead:
			'Si és el primer cop que veniu, demaneu un d\'aquests. Són els que sortim a defensar amb els ulls tancats, dia rere dia.',
		signatureBadge: 'El nostre senyal',
		priceFromLabel: 'Import',
	},
	es: {
		eyebrow: 'Platos firma',
		title: 'Tres clásicos. Sin excusas.',
		lead:
			'Si es la primera vez que venís, pedid uno de estos. Son los que defendemos con los ojos cerrados, día tras día.',
		signatureBadge: 'Nuestra seña',
		priceFromLabel: 'Importe',
	},
}[lang];

const priceFormatter = new Intl.NumberFormat(lang === 'ca' ? 'ca-ES' : 'es-ES', {
	style: 'currency',
	currency: 'EUR',
	maximumFractionDigits: 2,
});

const tagLabel: Record<string, { ca: string; es: string }> = {
	brasa: { ca: 'Brasa', es: 'Brasa' },
	vegetarian: { ca: 'Vegetarià', es: 'Vegetariano' },
	'gluten-free': { ca: 'Sense gluten', es: 'Sin gluten' },
	sharing: { ca: 'Per compartir', es: 'Para compartir' },
	spicy: { ca: 'Picant', es: 'Picante' },
};

const tagIcon: Record<string, string> = {
	brasa: 'flame',
	vegetarian: 'leaf',
	'gluten-free': 'circle-check',
	sharing: 'users',
	spicy: 'flame',
};

const cards = dishes.map((dish, i) => ({
	dish,
	number: String(i + 1).padStart(2, '0'),
	illustration: MENU_DISH_ILLUSTRATIONS[dish.id],
	tags: getDishTags(dish.id),
}));

const hero = cards[0];
const secondary = cards.slice(1, 3);
---

<section
	class="border-b border-border bg-background px-4 py-20 sm:px-6 md:py-28"
	aria-labelledby="menu-signature-heading"
>
	<div class="mx-auto max-w-6xl">
		<div class="max-w-2xl">
			<p class="text-xs font-semibold uppercase tracking-[0.26em] text-primary">
				{copy.eyebrow}
			</p>
			<h2
				id="menu-signature-heading"
				class="font-display mt-3 text-3xl font-semibold leading-[1.06] tracking-tight text-foreground md:text-5xl"
			>
				{copy.title}
			</h2>
			<p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
				{copy.lead}
			</p>
		</div>

		<div class="mt-12 grid gap-6 lg:grid-cols-12 lg:gap-8">
			{
				hero && (
					<article class="group relative flex flex-col overflow-hidden rounded-3xl border border-border bg-card shadow-sm transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl lg:col-span-7">
						<div class="relative aspect-[4/3] overflow-hidden bg-foreground/5 lg:aspect-[16/10]">
							{hero.illustration ? (
								<Picture
									src={hero.illustration}
									alt={getServiceName(hero.dish, lang)}
									formats={['avif', 'webp']}
									class="absolute inset-0 size-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-[1.05]"
									loading="lazy"
									decoding="async"
									sizes="(min-width: 1024px) 56vw, 100vw"
								/>
							) : (
								<div class="absolute inset-0 flex items-center justify-center bg-[color-mix(in_oklch,var(--color-primary)_8%,var(--color-card))]">
									<Icon name="tabler:meat" class="size-16 text-primary/40" aria-hidden="true" />
								</div>
							)}
							<div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/0 to-black/0" aria-hidden="true" />
							<span class="absolute left-5 top-5 inline-flex items-center gap-2 rounded-full bg-primary/95 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-primary-foreground shadow-lg">
								<Icon name="tabler:bookmark-filled" class="size-3.5" aria-hidden="true" />
								{copy.signatureBadge}
							</span>
							<span class="absolute right-5 top-5 inline-flex items-baseline rounded-full bg-card/85 px-3 py-1 font-display text-sm font-semibold text-foreground backdrop-blur">
								N°{hero.number}
							</span>
						</div>
						<div class="flex flex-1 flex-col gap-4 px-7 py-7 md:px-10 md:py-9">
							{hero.tags.length > 0 && (
								<ul class="flex flex-wrap gap-2">
									{hero.tags.map((tag) => (
										<li class="inline-flex items-center gap-1.5 rounded-full border border-border bg-background px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-foreground">
											<Icon
												name={`tabler:${tagIcon[tag]}`}
												class="size-3 text-primary"
												aria-hidden="true"
											/>
											{tagLabel[tag][lang]}
										</li>
									))}
								</ul>
							)}
							<h3 class="font-display text-3xl font-semibold leading-tight tracking-tight text-foreground md:text-4xl">
								{getServiceName(hero.dish, lang)}
							</h3>
							<p class="text-base leading-relaxed text-muted md:text-lg">
								{getServiceDescription(hero.dish, lang)}
							</p>
							<div class="mt-auto flex items-end justify-between gap-4 border-t border-border pt-5">
								<div>
									<p class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-muted">
										{copy.priceFromLabel}
									</p>
									<p class="mt-1 font-display text-3xl font-semibold tabular-nums text-foreground">
										{hero.dish.price !== null ? priceFormatter.format(hero.dish.price) : '—'}
									</p>
								</div>
							</div>
						</div>
					</article>
				)
			}

			<div class="flex flex-col gap-6 lg:col-span-5 lg:gap-8">
				{
					secondary.map((card) => (
						<article class="group relative flex flex-col overflow-hidden rounded-3xl border border-border bg-card shadow-sm transition-all duration-500 hover:-translate-y-1 hover:shadow-xl sm:flex-row sm:items-stretch lg:flex-col">
							<div class="relative aspect-[4/3] overflow-hidden bg-foreground/5 sm:aspect-square sm:w-2/5 sm:shrink-0 lg:aspect-[16/10] lg:w-full">
								{card.illustration ? (
									<Picture
										src={card.illustration}
										alt={getServiceName(card.dish, lang)}
										formats={['avif', 'webp']}
										class="absolute inset-0 size-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.05]"
										loading="lazy"
										decoding="async"
										sizes="(min-width: 1024px) 38vw, (min-width: 640px) 40vw, 100vw"
									/>
								) : (
									<div class="absolute inset-0 flex items-center justify-center bg-[color-mix(in_oklch,var(--color-primary)_8%,var(--color-card))]">
										<Icon name="tabler:meat" class="size-12 text-primary/40" aria-hidden="true" />
									</div>
								)}
								<span class="absolute right-3 top-3 inline-flex items-baseline rounded-full bg-card/85 px-2.5 py-0.5 font-display text-xs font-semibold text-foreground backdrop-blur">
									N°{card.number}
								</span>
							</div>
							<div class="flex flex-1 flex-col gap-3 px-6 py-6 sm:px-7 sm:py-7">
								{card.tags.length > 0 && (
									<ul class="flex flex-wrap gap-1.5">
										{card.tags.slice(0, 2).map((tag) => (
											<li class="inline-flex items-center gap-1 rounded-full border border-border bg-background px-2 py-0.5 text-[0.6rem] font-semibold uppercase tracking-[0.16em] text-foreground">
												<Icon
													name={`tabler:${tagIcon[tag]}`}
													class="size-2.5 text-primary"
													aria-hidden="true"
												/>
												{tagLabel[tag][lang]}
											</li>
										))}
									</ul>
								)}
								<h3 class="font-display text-2xl font-semibold leading-tight tracking-tight text-foreground">
									{getServiceName(card.dish, lang)}
								</h3>
								<p class="text-sm leading-relaxed text-muted">
									{getServiceDescription(card.dish, lang)}
								</p>
								<div class="mt-auto flex items-end justify-between border-t border-border pt-4">
									<div>
										<p class="text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-muted">
											{copy.priceFromLabel}
										</p>
										<p class="mt-0.5 font-display text-2xl font-semibold tabular-nums text-foreground">
											{card.dish.price !== null ? priceFormatter.format(card.dish.price) : '—'}
										</p>
									</div>
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</div>
</section>
