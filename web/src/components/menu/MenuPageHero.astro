---
/**
 * Cinematic full-bleed hero for the carta page.
 *
 * Replaces the old text-left + image-right split with a single dramatic
 * brasa image and overlaid editorial typography. Tuned to read against the
 * gastro-charcoal palette and the warm primary tone of the shell.
 */
import Button from '../Button.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';
import { business } from '../../data/business';
import { getBookingCta } from '../../data/site';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const booking = getBookingCta();

const cleanPhone = business.phoneTel.replace(/\D/g, '');
const waMessage = t('services.heroWhatsAppMessage');
const waUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(waMessage)}`;

const copy = {
	ca: {
		eyebrow: 'Carta · L\'Ametlla del Vallès',
		title: 'De la brasa,',
		titleSecond: 'a la taula.',
		lead:
			'Cuina informal de bar amb caràcter: brases, combinats, tapes per allargar la sobretaula i entrepans de tota la vida. Preus orientatius — al·lèrgens sempre detallats al servei.',
		jump: 'Veure la carta',
	},
	es: {
		eyebrow: 'Carta · La Ametlla del Vallès',
		title: 'De la brasa,',
		titleSecond: 'a la mesa.',
		lead:
			'Cocina de bar con carácter: brasas, combinados, tapas para alargar la sobremesa y bocadillos de siempre. Precios orientativos — alérgenos siempre detallados en sala.',
		jump: 'Ver la carta',
	},
}[lang];
---

<section
	class="menu-page-hero relative isolate overflow-hidden text-on-image"
	aria-labelledby="menu-page-hero-title"
>
	<div class="absolute inset-0 z-0 bg-foreground">
		<img
			src="/menu/hero-brasa.webp"
			alt=""
			role="presentation"
			data-placeholder="true"
			loading="eager"
			decoding="async"
			fetchpriority="high"
			class="size-full object-cover object-center motion-safe:animate-[mn-menu-hero_28s_ease-in-out_infinite_alternate]"
		/>
		<div
			class="absolute inset-0 bg-gradient-to-b from-black/55 via-black/40 to-black/85"
			aria-hidden="true"
		>
		</div>
		<div
			class="absolute inset-0 bg-[radial-gradient(ellipse_at_25%_15%,color-mix(in_oklch,var(--color-primary)_24%,transparent),transparent_55%)]"
			aria-hidden="true"
		>
		</div>
	</div>

	<div
		class="relative z-10 mx-auto flex min-h-[clamp(580px,82svh,860px)] max-w-6xl flex-col justify-end px-4 pb-16 pt-32 sm:px-6 md:pb-24 md:pt-40"
	>
		<p
			class="font-body text-xs font-semibold uppercase tracking-[0.32em] text-on-image/85"
		>
			<span class="inline-block size-1.5 rounded-full bg-primary align-middle"></span>
			<span class="ml-2 align-middle">{copy.eyebrow}</span>
		</p>
		<h1
			id="menu-page-hero-title"
			class="font-display mt-5 max-w-4xl text-[clamp(2.75rem,7.4vw,6rem)] font-semibold leading-[0.96] tracking-tight"
		>
			{copy.title}<br /><span class="text-primary">{copy.titleSecond}</span>
		</h1>
		<p class="mt-7 max-w-2xl text-lg leading-relaxed text-on-image/90 md:text-xl">
			{copy.lead}
		</p>

		<ul
			class="mt-8 flex flex-wrap gap-x-5 gap-y-2 font-body text-xs font-semibold uppercase tracking-[0.18em] text-on-image/85"
			aria-hidden="false"
		>
			<li class="inline-flex items-center gap-2">
				<Icon name="tabler:flame" class="size-4 text-primary shrink-0" aria-hidden="true" />
				{t('services.menuHeroChipBrasa')}
			</li>
			<li class="inline-flex items-center gap-2">
				<Icon name="tabler:leaf" class="size-4 text-primary shrink-0" aria-hidden="true" />
				{t('services.menuHeroChipFresh')}
			</li>
			<li class="inline-flex items-center gap-2">
				<Icon
					name="tabler:info-circle"
					class="size-4 text-primary shrink-0"
					aria-hidden="true"
				/>
				{t('services.menuHeroChipAllergens')}
			</li>
		</ul>

		<div class="mt-10 flex flex-wrap gap-3">
			<Button
				as="a"
				href={booking.href}
				external={booking.external}
				variant="primary"
				size="lg"
				class="shadow-md"
			>
				<Icon
					slot="icon-leading"
					name="tabler:phone"
					class="size-5 shrink-0"
					aria-hidden="true"
				/>
				{t('cta.callToBook')}
			</Button>
			<a
				href={waUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center justify-center gap-2 rounded-full border border-on-image/30 bg-card/10 px-6 py-3 font-body text-base font-semibold text-on-image backdrop-blur-md transition-colors hover:bg-card/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-on-image focus-visible:ring-offset-2 focus-visible:ring-offset-foreground"
			>
				{t('services.heroCtaWhatsApp')}
				<Icon
					name="tabler:brand-whatsapp"
					class="size-4 shrink-0"
					aria-hidden="true"
				/>
			</a>
			<a
				href="#menu-dishes-start"
				class="inline-flex items-center justify-center gap-2 rounded-full border border-on-image/20 bg-transparent px-5 py-3 font-body text-sm font-semibold uppercase tracking-[0.18em] text-on-image/80 transition-colors hover:bg-card/10 hover:text-on-image focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-on-image focus-visible:ring-offset-2 focus-visible:ring-offset-foreground"
			>
				{copy.jump}
				<Icon name="tabler:chevron-down" class="size-4 shrink-0" aria-hidden="true" />
			</a>
		</div>
	</div>
</section>

<style>
	@keyframes mn-menu-hero {
		0% {
			transform: scale(1.04) translate3d(0, 0, 0);
		}
		100% {
			transform: scale(1.12) translate3d(-1.5%, -0.8%, 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.menu-page-hero img {
			animation: none !important;
		}
	}
</style>
