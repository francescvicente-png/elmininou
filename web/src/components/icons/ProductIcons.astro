---
/**
 * ProductIcons
 *
 * Maps a `product.iconKey` to the right SVG. Sprint 3 switched the
 * generic shapes to Tabler Icons (jar, droplet, brush, bottle, cup)
 * for legibility; `comb` keeps a custom inline SVG because Tabler
 * doesn't ship a comb glyph.
 *
 * The custom `comb` SVG follows the Tabler conventions on purpose
 * (24×24 viewBox, stroke 2, round caps and joins, fill none) so it
 * sits next to the other product icons without standing out.
 */
import { Icon } from 'astro-icon/components';
import type { ProductIconKey } from '../../data/products';

interface Props {
	name: ProductIconKey;
	class?: string;
	decorative?: boolean;
	label?: string;
}

const TABLER_ICON: Partial<Record<ProductIconKey, string>> = {
	wax: 'tabler:container',
	oil: 'tabler:droplet',
	brush: 'tabler:brush',
	shampoo: 'tabler:bottle',
	balm: 'tabler:cup',
};

const { name, class: className, decorative = true, label } = Astro.props;
const ariaProps = decorative
	? { 'aria-hidden': 'true' as const }
	: { 'aria-label': label ?? name, role: 'img' as const };

const tablerName = TABLER_ICON[name];
---

{
	tablerName ? (
		<Icon name={tablerName} class={className} {...ariaProps} />
	) : (
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			class={className}
			{...ariaProps}
		>
			{name === 'comb' && (
				<>
					{/* Wide-tooth wooden comb. Single horizontal spine with
					    five vertical teeth — clean silhouette at 24px. */}
					<path d="M3 8h18v3H3z" />
					<line x1="6" y1="11" x2="6" y2="20" />
					<line x1="9" y1="11" x2="9" y2="18" />
					<line x1="12" y1="11" x2="12" y2="20" />
					<line x1="15" y1="11" x2="15" y2="18" />
					<line x1="18" y1="11" x2="18" y2="20" />
				</>
			)}
		</svg>
	)
}
