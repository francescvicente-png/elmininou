---
/**
 * ProductCard
 *
 * Card layout intentionally parallel to ServiceCard so the Products
 * page reads as a sibling of the Services page. Differences:
 *   - Hero product photograph (real packshots replace AI placeholders in data).
 *   - Optional "Producto de ejemplo" badge while `isPlaceholder`.
 *   - Footer is a price `<dl>` with the same caption typography as
 *     ServiceCard (`products.priceLabel` + formatted EUR).
 *
 * Hover / lift / shadow stack mirror ServiceCard so both catalog pages read
 * as one family (see ServiceCard.astro scoped styles).
 */
import { Picture } from 'astro:assets';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/config';
import type { Product } from '../data/products';
import Badge from './Badge.astro';
import DrawnBorder from './decorative/DrawnBorder.astro';
import Heading from './Heading.astro';

type HeadingLevel = 'h2' | 'h3' | 'h4';

interface Props {
	product: Product;
	lang: Lang;
	class?: string;
	/** Semantic heading level for the product name. Default h3. */
	headingLevel?: HeadingLevel;
}

const { product, lang, class: className, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(lang);

const name = lang === 'ca' ? product.nameCa : product.nameEs;
const description = lang === 'ca' ? product.descriptionCa : product.descriptionEs;

const priceFormatter = new Intl.NumberFormat('es-ES', {
	style: 'currency',
	currency: 'EUR',
	maximumFractionDigits: product.price % 1 === 0 ? 0 : 2,
});
---

<article
	class:list={[
		'product-card drawn-border-host relative rounded-xl border border-border bg-card overflow-hidden flex flex-col p-0',
		className,
	]}
>
	<DrawnBorder />
	<div class="product-card-figure relative aspect-[4/3] w-full shrink-0 bg-[color-mix(in_oklch,var(--color-muted)_15%,var(--color-background))]">
		<Picture
			src={product.image}
			alt={product.imageAlt[lang]}
			formats={['avif', 'webp', 'png']}
			class="h-full w-full object-cover"
			loading="lazy"
			decoding="async"
			sizes="(min-width: 1024px) 33vw, 90vw"
		/>
		<div class="product-card-figure-scrim pointer-events-none absolute inset-0" aria-hidden="true" />
		{
			product.isPlaceholder && (
				<div class="absolute top-3 right-3 z-[1]">
					<Badge variant="outline" class="bg-card/95 backdrop-blur-sm shadow-sm">
						{t('products.exampleBadge')}
					</Badge>
				</div>
			)
		}
	</div>
	<div class="flex min-h-0 flex-1 flex-col gap-4 p-6">
		<div class="min-h-0 flex-1 space-y-2">
			<Heading as={headingLevel} size="h3" class="!text-2xl !md:text-2xl">
				{name}
			</Heading>
			<p class="text-base text-muted leading-relaxed">{description}</p>
		</div>
		<dl class="mt-auto w-full border-t border-border pt-4 font-body text-sm">
			<div class="flex flex-col items-end gap-1 text-right">
				<dt class="text-[0.65rem] font-medium uppercase tracking-[0.14em] text-foreground/78">
					{t('products.priceLabel')}
				</dt>
				<dd class="m-0 font-semibold tabular-nums text-foreground">
					{priceFormatter.format(product.price)}
				</dd>
			</div>
		</dl>
	</div>
</article>

<style>
	/* Same “editorial material” stack as ServiceCard — one surface language
	   across Services + Products catalog pages. */
	.product-card {
		box-shadow:
			0 1px 0 0 oklch(98% 0.01 85 / 0.04) inset,
			0 0 0 1px oklch(0% 0 0 / 0.12) inset,
			0 4px 20px -6px oklch(0% 0 0 / 0.45);
		transition:
			transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
			box-shadow 420ms cubic-bezier(0.16, 1, 0.3, 1),
			border-color 420ms cubic-bezier(0.16, 1, 0.3, 1);
		will-change: transform;
	}

	.product-card-figure-scrim {
		background: linear-gradient(
			to top,
			color-mix(in oklch, var(--color-card) 88%, transparent) 0%,
			color-mix(in oklch, var(--color-card) 20%, transparent) 42%,
			transparent 72%
		);
	}

	.product-card:hover {
		transform: translateY(-5px);
		box-shadow:
			0 1px 0 0 oklch(98% 0.01 85 / 0.07) inset,
			0 0 0 1px oklch(56% 0.11 320 / 0.22) inset,
			0 18px 40px -10px oklch(30% 0.08 320 / 0.35);
		border-color: color-mix(in oklch, var(--color-primary) 70%, var(--color-border));
	}

	.product-card:active {
		transform: translateY(-2px) scale(0.992);
		transition-duration: 120ms;
	}

	@media (prefers-reduced-motion: reduce) {
		.product-card {
			box-shadow:
				0 1px 0 0 oklch(98% 0.01 85 / 0.04) inset,
				0 0 0 1px oklch(0% 0 0 / 0.12) inset,
				0 4px 20px -6px oklch(0% 0 0 / 0.45);
		}

		.product-card,
		.product-card:hover,
		.product-card:active {
			transition: none;
			transform: none;
			box-shadow:
				0 1px 0 0 oklch(98% 0.01 85 / 0.04) inset,
				0 0 0 1px oklch(0% 0 0 / 0.12) inset,
				0 4px 20px -6px oklch(0% 0 0 / 0.45);
		}
	}
</style>
