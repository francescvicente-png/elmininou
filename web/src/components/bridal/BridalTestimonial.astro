---
/**
 * BridalTestimonial — single oversized pull-quote.
 *
 * The page surfaces ONE real customer voice taken verbatim from
 * `data/reviews.ts` (Isabel Romero — "He entrado hecha una pena y la
 * salida ha sido triunfal"). The transformational arc fits the bridal
 * narrative naturally without us inventing a fake bride testimonial.
 *
 * Composition: enormous opening quotation mark in champagne, the
 * sentence in display serif at h1-ish size, attribution + verification
 * note small below. No avatar (the original review on Google does have
 * an authorInitial but rendering a circle here would compete with the
 * editorial restraint).
 *
 * Skills enforced:
 *   - soft-skill §3 (Editorial Luxury archetype) — display serif quote
 *   - redesign-skill ("3-card carousel testimonials" → single rotating
 *     quote alternative)
 *   - taste-skill (anti-card overuse — quote breathes on the bg)
 *
 * Honesty note (per user rules): the quote is real and verifiable on
 * Google. The reused-context line below it reflects this transparently.
 */
import Container from '../Container.astro';
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
	class="bridal-testimonial relative bg-card border-y border-border py-24 md:py-32 lg:py-36 overflow-hidden"
	aria-labelledby="bridal-testimonial-eyebrow"
>
	<Container class="!max-w-5xl">
		<div class="text-center md:text-left fade-in-on-scroll" style="--fade-delay: 80ms; --fade-duration: 800ms;">
			<p
				id="bridal-testimonial-eyebrow"
				class="bridal-eyebrow flex items-center justify-center md:justify-start gap-2 mb-10"
			>
				<Icon
					name="tabler:quote"
					class="h-3.5 w-3.5 text-accent shrink-0"
					aria-hidden="true"
				/>
				<span>{t('bridal.testimonialEyebrow')}</span>
			</p>
			<blockquote class="bridal-testimonial-block">
				<span class="bridal-testimonial-mark" aria-hidden="true">&ldquo;</span>
				<p class="bridal-testimonial-quote font-display text-foreground">
					{t('bridal.testimonialQuote')}
				</p>
			</blockquote>
			<footer class="bridal-testimonial-footer">
				<p class="bridal-testimonial-author font-body">
					— {t('bridal.testimonialAuthor')}
				</p>
				<p class="bridal-testimonial-context font-body text-muted">
					<Icon
						name="tabler:circle-check"
						class="h-3.5 w-3.5 text-accent shrink-0 inline-block align-[-2px] mr-1.5"
						aria-hidden="true"
					/>
					{t('bridal.testimonialContext')}
				</p>
			</footer>
		</div>
	</Container>
</section>

<style>
	.bridal-eyebrow {
		font-family: var(--font-body), system-ui, sans-serif;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.32em;
		color: var(--color-muted);
		margin: 0;
	}

	.bridal-testimonial-block {
		position: relative;
		margin: 0;
		padding: 0;
	}

	.bridal-testimonial-mark {
		position: absolute;
		left: -0.4rem;
		top: -3.5rem;
		font-family: var(--font-display), Georgia, serif;
		font-size: clamp(7rem, 11vw + 1rem, 14rem);
		line-height: 1;
		color: color-mix(in oklch, var(--color-accent) 22%, transparent);
		pointer-events: none;
		user-select: none;
		z-index: 0;
	}

	@media (max-width: 768px) {
		.bridal-testimonial-mark {
			/* Hide the oversized decorative mark on mobile to avoid
			   collision with the eyebrow above. The eyebrow already
			   carries a small `tabler:quote` icon, which is enough
			   semantic punctuation in a narrow viewport. */
			display: none;
		}
	}

	.bridal-testimonial-quote {
		position: relative;
		font-size: clamp(1.875rem, 3.6vw + 1rem, 4rem);
		line-height: 1.1;
		letter-spacing: -0.018em;
		font-style: italic;
		font-weight: 400;
		text-wrap: balance;
		max-width: 24ch;
		margin: 0;
	}

	@media (max-width: 768px) {
		.bridal-testimonial-quote {
			max-width: none;
		}
	}

	.bridal-testimonial-footer {
		margin-top: 2.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.bridal-testimonial-author {
		font-size: 1rem;
		font-weight: 500;
		color: var(--color-foreground);
		letter-spacing: 0.02em;
		margin: 0;
	}

	.bridal-testimonial-context {
		font-size: 0.78rem;
		max-width: 50ch;
		margin: 0;
	}

	@media (max-width: 768px) {
		.bridal-testimonial-footer {
			align-items: center;
			text-align: center;
		}
	}
</style>
