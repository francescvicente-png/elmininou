/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.clarity.ms https://*.clarity.ms; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://www.clarity.ms https://*.clarity.ms; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# Cache estático con hash de contenido (largo plazo)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fuentes optimizadas
/_astro/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes en /og/
/og/*
  Cache-Control: public, max-age=86400

# Brand mark — stable filename (overwritten when logo changes); avoid immutable
# so updates propagate within a day.
/brand/*
  Cache-Control: public, max-age=86400

# robots y sitemap (cache corto)
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap-index.xml
  Cache-Control: public, max-age=3600
