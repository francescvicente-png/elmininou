# Dependencies
node_modules/
.pnpm-store/

# Generated by scripts/copy-brand-logo.mjs (source: El mini nou logo.jpg)
public/brand/el-mini-nou-logo.jpg
public/favicon-32.png
public/favicon-180.png
public/favicon-192.png
public/favicon-512.png

# Build output
dist/
.astro/
.vite/

# Cache
node_modules/.astro/
node_modules/.vite/
node_modules/.cache/

# Environment variables (never commit real values)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Editors and IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db

# Test coverage reports
coverage/

# Lighthouse reports (locales, no se commitean)
lighthouse-*.json
lighthouse-*.html

# Tmp
/tmp/

# Local palette A/B builds (generated by scripts/build-k1-k2-previews.mjs)
preview-palettes-k12/

# Claude Code local config (per-user, not part of the project)
.claude/

# Bundled archive of screenshots — never commit the zip (it's just
# the screenshots/ folder packaged for one-click download). The
# folder itself IS committed (see screenshots/) so the deck images
# are accessible from GitHub.
*-screenshots.zip
